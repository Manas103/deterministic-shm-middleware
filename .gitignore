# Build directories. Regenerate with:
#   cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j"$(( $(nproc)/2 ))"
#   cmake -S . -B build_asan -DCMAKE_BUILD_TYPE=Debug -DENABLE_ASAN=ON && cmake --build build_asan -j"$(( $(nproc)/2 ))"
#   cmake -S . -B build_tsan -DCMAKE_BUILD_TYPE=Debug -DENABLE_TSAN=ON && cmake --build build_tsan -j"$(( $(nproc)/2 ))"
build/
build_asan/
build_tsan/
*.o
*.obj
*.a
*.log
!docs/*.txt
CMakeFiles/
CMakeCache.txt

__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
